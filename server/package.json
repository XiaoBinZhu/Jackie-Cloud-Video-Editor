{
  "name": "video-render-server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pack:linux": "npm install --platform=linux --arch=x64 && npx pkg ."
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.4.0",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffcreatorlite": "^2.5.1",
    "fluent-ffmpeg": "^2.1.2",
    "uuid": "^9.0.0"
  },
  "pkg": {
    "targets": [
      "node18-linux-x64"
    ],
    "outputPath": "dist",
    "outputName": "server-linux",
    "scripts": [
      "build.js",
      "services/**/*",
      "utils/**/*",
      "routes/**/*",
      "render/**/*",
      "config/**/*",
      "middleware/**/*"
    ]
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "pkg": "^5.8.1"
  }
}